# 名前の一覧です。値はこのファイルに書かず、本番は `wrangler secret put`、
# 手元の vite dev は .dev.vars に入れます。手順は docs/SETUP.md。
# wrangler.jsonc の vars に入っているものはここへ書かなくてよい
# （ALLOWED_EMAIL_DOMAIN, DRIVE_ROOT_FOLDER_ID, GEMINI_MODEL,
#  GEMINI_EMBEDDING_MODEL, LLM_PROVIDER, WORKERS_AI_MODEL, WORKERS_AI_EMBEDDING_MODEL）。

# Cloudflare Access のチーム名（サブドメインだけ、または team.cloudflareaccess.com）
CF_ACCESS_TEAM_DOMAIN=
# Access アプリケーションの AUD タグ
CF_ACCESS_AUD=

# Apps Script ウェブアプリの /exec URL と、スクリプトプロパティと同じ秘密
APPS_SCRIPT_URL=
# openssl rand -base64 32
APPS_SCRIPT_SECRET=

# 任意。Worker の意味検索と、AI Studio が使えるときの項目抽出。
# スクリプト側にだけ置く場合は、Worker の埋め込みは Workers AI になる。
GEMINI_API_KEY=

# 任意。auto / gemini / workers-ai。未設定は auto（Gemini があれば Gemini、無ければ Workers AI）
# LLM_PROVIDER=auto

# 任意。オープンアクセス PDF を Apps Script に取らせるとき
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=

# ローカルの画面確認だけ。本番のシークレットには置かない。本番では無視される。
# AUTH_DISABLED=true
# SCI_BRIDGE_MOCK=1
