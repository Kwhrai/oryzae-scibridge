# コピーして .env.local を作り、値を入れる。このファイルに本物の秘密情報は書かない。
# 手順の全体は docs/SETUP.md。

# --- Auth.js（ログイン） ---
# openssl rand -base64 32
AUTH_SECRET=
# 本番は https://oryzae-scibridge.vercel.app など、末尾スラッシュなし
AUTH_URL=http://localhost:3000
# Google Cloud の OAuth クライアント（ウェブ）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# このドメインの Google Workspace アカウントだけ通す
ALLOWED_EMAIL_DOMAIN=oryzae.site

# --- Neon Postgres（論文・ベクトル） ---
# Pooled connection を使う。pgvector が有効なこと。
DATABASE_URL=

# --- Gemini（意味検索・PDFからの項目抽出・構造化） ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 768次元で保存している。モデルを変えるときは output 次元も 768 のままにする。
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Google Drive（共有ドライブの原本PDF） ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 改行は \n のままでよい（アプリ側で実改行に戻す）
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# 既報研究（ORYZAE Scibridge）
DRIVE_ROOT_FOLDER_ID=1f8kMQgoqvp9H0IIwzD6BAZ2-vcqIHHun

# --- 任意。オープンアクセスPDFの取得（Unpaywall）と Crossref の礼儀 ---
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=

# --- ローカル確認用。本番（NODE_ENV=production / Vercel production）では無視される ---
# AUTH_DISABLED=true
# SCI_BRIDGE_MOCK=1
