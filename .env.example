# 名前の一覧です。値はこのファイルに書かず、本番は `wrangler secret put`、
# 手元の vite dev は .dev.vars に入れます。手順は docs/SETUP.md。
# wrangler.jsonc の vars に入っているものはここへ書かなくてよい
# （ALLOWED_EMAIL_DOMAIN, DRIVE_ROOT_FOLDER_ID, GEMINI_MODEL, GEMINI_EMBEDDING_MODEL）。

# openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

GEMINI_API_KEY=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 改行は \n のままでよい
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# 任意。オープンアクセス PDF を Drive に置くとき
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=

# ローカルの画面確認だけ。本番のシークレットには置かない。本番では無視される。
# AUTH_DISABLED=true
# SCI_BRIDGE_MOCK=1
