{
  "name": "oryzae-scibridge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:mock": "node scripts/dev-mock.mjs",
    "build": "vite build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply scibridge --local",
    "db:migrate": "wrangler d1 migrations apply scibridge --remote",
    "types": "wrangler types",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.3.4",
    "lucide-react": "^0.555.0",
    "next": "^15.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.5",
    "wrangler": "^4.162.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.8",
    "vitest": "^4.0.8"
  }
}
